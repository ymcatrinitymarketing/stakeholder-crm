datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Stakeholder {
  id                  Int      @id @default(autoincrement())
  category            String
  organisation        String?
  name                String
  role                String?
  contact_details     String?
  focus_areas         String?
  tier                Int      // 1: Excellent, 2: Good, 3: Some/Little, 4: No Contact
  main_contact        String?
  owned_by            String?  // Jonathan, Amanda, Ian, Unassigned
}
